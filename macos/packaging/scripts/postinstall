#!/bin/bash

set -u

app_path="/Applications/百战异闻录助手.app"
console_user=$(/usr/bin/stat -f '%Su' /dev/console)

if [ ! -d "$app_path" ] || [ -z "$console_user" ] || [ "$console_user" = "root" ] || [ "$console_user" = "loginwindow" ]; then
  exit 0
fi

console_uid=$(/usr/bin/id -u "$console_user")

# Reopen the freshly installed copy in the active desktop session and as the
# signed-in user, rather than in the installer's root session.
/bin/launchctl asuser "$console_uid" \
  /usr/bin/sudo -u "$console_user" /usr/bin/open "$app_path" >/dev/null 2>&1 || true

exit 0

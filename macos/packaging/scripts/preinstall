#!/bin/bash

set -u

app_executable="/Applications/百战异闻录助手.app/Contents/MacOS/百战异闻录助手"

# Stop the installed copy before pkgbuild replaces its files. Without this,
# macOS keeps the old executable and Flutter assets alive until the user quits.
/usr/bin/pkill -f "^${app_executable}( |$)" 2>/dev/null || true

for _ in 1 2 3 4 5; do
  if ! /usr/bin/pgrep -f "^${app_executable}( |$)" >/dev/null 2>&1; then
    exit 0
  fi
  /bin/sleep 1
done

# Do not fail installation if an older process takes longer to terminate.
exit 0
